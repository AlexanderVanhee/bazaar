using Gtk 4.0;
using Adw 1;

template $BzRemotesDialog: Adw.Dialog {
  title: _("Remotes");
  content-width: 640;
  content-height: 580;

  child: Adw.NavigationView navigation_view {
    Adw.NavigationPage {
      title: _("Remotes");
      tag: "list";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Stack list_stack {
          StackPage {
            name: "loading";

            child: Adw.Spinner {
              width-request: 32;
              height-request: 32;
              halign: center;
              valign: center;
            };
          }

          StackPage {
            name: "list";

            child: Adw.PreferencesPage {
              Adw.PreferencesGroup system_group {
                title: _("System Installation");
                description: _("Available to all users on this computer");
              }

              Adw.PreferencesGroup user_group {
                title: _("User Installation");
                description: _("Only available to you");
              }
            };
          }

          StackPage {
            name: "empty";

            child: Adw.StatusPage {
              icon-name: "package-x-generic-symbolic";
              title: _("No Remotes");
              description: _("Add a remote to start installing apps");
            };
          }
        };
      };
    }

    Adw.NavigationPage {
      title: _("Remove Remote");
      tag: "confirm";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
        }

        content: Overlay {
          child: ScrolledWindow {
            hscrollbar-policy: never;
            vexpand: true;

            child: Adw.Clamp {
              maximum-size: 582;

              child: Box {
                orientation: vertical;
                spacing: 32;
                margin-top: 24;
                margin-bottom: 100;
                margin-start: 6;
                margin-end: 6;

                Box {
                  orientation: vertical;
                  spacing: 12;

                  Label confirm_title {
                    wrap: true;
                    justify: center;
                    margin-top: 8;

                    styles [
                      "title-1",
                    ]
                  }

                  Label confirm_body {
                    wrap: true;
                    justify: center;
                    max-width-chars: 48;
                  }
                }

                Adw.PreferencesGroup apps_group {
                  Box apps_box {
                    orientation: vertical;
                    spacing: 10;
                  }
                }
              };
            };
          };

          [overlay]
          Button {
            label: _("_Remove");
            use-underline: true;
            halign: center;
            valign: end;
            margin-bottom: 24;
            clicked => $on_confirm_clicked();

            styles [
              "suggested-action",
              "pill",
            ]
          }
        };
      };
    }
  };
}
