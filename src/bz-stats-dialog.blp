using Gtk 4.0;
using Adw 1;

template $BzStatsDialog: Adw.BreakpointBin {
  width-request: 360;
  height-request: 450;
  child: Adw.ToolbarView {
    bottom-bar-style: raised_border;

    [top]
    Adw.HeaderBar {
      title-widget: Adw.ViewSwitcher switcher_title {
        visible: bind $has_country_model(template.country-model) as <bool>;
        stack: stack;
        policy: wide;
      };
    }

    content: Box {
      orientation: vertical;

      Adw.ViewStack stack {
        vexpand: true;

        Adw.ViewStackPage {
          name: "graph";
          // TRANSLATORS: page in the statistics dialog
          title: _("Timeline");
          icon-name: "graph2-symbolic";

          child: Box graph_page {
            orientation: vertical;
            margin-top: 12;
            margin-start: 24;
            margin-end: 24;
            margin-bottom: 24;

            Grid header {
              margin-start: 12;
              margin-end: 12;
              column-spacing: 60;
              hexpand: true;
              halign: start;

              Label total_label {
                // TRANSLATORS: total number of installs of an app, shown in the statistics dialog
                label: _("Total");
                halign: start;

                layout {
                  column: 0;
                  row: 0;
                }
              }

              Label {
                label: bind $format_installs(template.total-downloads) as <string>;
                halign: start;

                layout {
                  column: 0;
                  row: 1;
                }

                styles [
                  "stats-value",
                ]

                accessibility {
                  labelled-by: [
                    total_label,
                  ];
                }
              }

              Label week_label {
                // TRANSLATORS: installs in the last 7 days, shown in the statistics dialog
                label: _("This Week");
                halign: start;

                layout {
                  column: 1;
                  row: 0;
                }
              }

              Label {
                label: bind $format_last_week(template.model) as <string>;
                halign: start;

                layout {
                  column: 1;
                  row: 1;
                }

                styles [
                  "stats-value",
                ]

                accessibility {
                  labelled-by: [
                    week_label,
                  ];
                }
              }
            }

            $BzDataGraph {
              model: bind template.model;
              vexpand: true;
              hexpand: true;
              margin-top: 12;

              accessibility {
                label: _("Installs per day");
              }
            }
          };
        }

        Adw.ViewStackPage {
          name: "map";
          // TRANSLATORS: page in the statistics dialog
          title: _("World");
          icon-name: "globe-symbolic";

          child: Box {
            orientation: vertical;
            margin-top:10;
            margin-bottom: 10;

            $BzWorldMap world_map {
              model: bind template.country-model;
              vexpand: true;
            }

            Label {
              label: _("Since 4/15/2024");
              halign: center;

              styles [
                "dimmed",
                "caption"
              ]
            }
          };
        }
      }

      Adw.ViewSwitcherBar switcher_bar {
        visible: bind $has_country_model(template.country-model) as <bool>;
        stack: stack;
      }
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 450sp")

    setters {
      switcher_title.stack: null;
      switcher_bar.reveal: true;
      graph_page.margin-start: 0;
      graph_page.margin-end: 0;
      graph_page.margin-bottom: 0;
    }
  }
}