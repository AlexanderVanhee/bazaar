using Gtk 4.0;

Box root {
  orientation: horizontal;

  StackSidebar {
    stack: stack;
  }

  Stack stack {
    transition-type: none;

    StackPage {
      name: "markdown";
      title: "Markdown";

      child: ScrolledWindow {
        child: $BgeMarkdownRender markdown {
          margin-start: 10;
          margin-end: 10;
        };
      };
    }

    StackPage {
      name: "carousel";
      title: "Carousel";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Box carousel_box {
          valign: center;
          orientation: vertical;
          spacing: 4;
        };
      };
    }
  }
}
